# council-mcp configuration.
#
# Copy to .dev.vars for local development, or set each value as a Cloudflare
# secret for deployment:  echo "<value>" | npx wrangler secret put NAME
#
# MCP_AUTH_TOKEN is the only required value. Each provider key is optional: a
# council member whose key is missing is left out, so set the keys for the
# members you want.

# ── Required ────────────────────────────────────────────────────────────────
# The bearer token every MCP client must send. Generate one with:
#   echo "council_$(openssl rand 32 | base64 | tr '+/' '-_' | tr -d '=\n')"
MCP_AUTH_TOKEN=

# ── Provider keys ───────────────────────────────────────────────────────────
# Anthropic — https://platform.claude.com — Claude Fable 5.2
ANTHROPIC_API_KEY=

# OpenAI — https://platform.openai.com — GPT-6.2 Astra
OPENAI_API_KEY=

# Google AI Studio — https://aistudio.google.com — Gemini 4 Neon
GEMINI_API_KEY=

# Ollama cloud — https://ollama.com/settings/keys — Kimi K3.1 Pro (first choice)
OLLAMA_API_KEY=

# Fireworks — https://fireworks.ai — Kimi K3.1 Pro (used if Ollama fails)
FIREWORKS_API_KEY=
